{
    "manifest_version": 3,
    "name": "Rust Drops Bridge",
    "version": "0.2.0",
    "description": "Sends your Twitch drop inventory to the local Rust Twitch Drops Watcher.",
    "permissions": ["alarms"],
    "host_permissions": [
        "https://www.twitch.tv/*",
        "http://127.0.0.1:8787/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://www.twitch.tv/drops/inventory*"],
            "js": ["inventory.js"],
            "run_at": "document_idle"
        }
    ]
}
